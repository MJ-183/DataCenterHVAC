{
  "id": "esif",
  "label": "NREL ESIF HPC 데이터센터 (Golden, CO)",
  "description": "랙 직접 액체냉각(95% 이상), 칠러 없음, 냉각탑 + 열사이펀 + 건물 난방 재활용. 시간 평균 IT·냉각탑계·펌프·공조 팬·조명·PUE 실측 (NREL 원본 1~5분 값 → 시간 평균).",
  "data": {"csv": "data_esif/esif_hourly_mst.csv", "timestamp": "timestamp_mst", "timezone": "MST (UTC−7, 일광절약시간 없음)"},
  "mapping": {
    "timestamp": "timestamp_mst",
    "it": "it_power_kw",
    "items": {"cooling_kw": ["tower_fan"], "pump_kw": ["chw_pump", "cw_pump", "liquid_pump"], "hvac_kw": ["crah_fan"]},
    "labels": {"cooling_kw": "냉각탑계", "pump_kw": "펌프", "hvac_kw": "공조 팬"},
    "definitions": {
      "cooling_kw": "냉각탑·건식냉각기 팬 + 동결방지 열선 + 필터 펌프 2.67 kW 고정 ↔ 시뮬 tower_fan",
      "pump_kw": "에너지회수수(ERW)·냉각탑수 루프 펌프 + 팬월 부스터 펌프 ↔ 시뮬 chw_pump + cw_pump + liquid_pump",
      "hvac_kw": "팬월 + 전기실 팬코일 + 외기 공급기 ↔ 시뮬 crah_fan",
      "plug_and_light_kw": "조명·콘센트 (시뮬은 조명 입력값, 비교 대상 아님)"
    },
    "lighting": "plug_and_light_kw",
    "pue_column": "pue",
    "pue_terms": ["it", "cooling_kw", "pump_kw", "hvac_kw", "plug_and_light_kw"],
    "ups_loss": 0.0,
    "dry_bulb": null,
    "rh": null
  },
  "periods": {"cal": ["2016-09-01", "2017-08-31"], "test": ["2019-01-01", "2019-12-31"]},
  "period_notes": {"cal": "NREL 공개 1차년도와 같은 기간 (PUE 1.034, WUE 0.7)", "test": "보정 계수 검증용 (IT 부하 약 1.3배)"},
  "weather": {
    "epw": "validation_esif/golden_tmy3.epw",
